@page "/wskazniki"
@rendermode InteractiveServer
@attribute [StreamRendering]
@using System.Globalization
@using BlazorApp1.Features.Models
@using BlazorApp1.Features.Services
@inject AnalysisApplicationService AnalysisService
@inject AnalysisStores SettingsStore

<PageTitle>Wskaźniki</PageTitle>

<h1>Wskaźniki analizy technicznej</h1>

<div class="mb-3">
    <button class="btn btn-primary" @onclick="LoadAsync">Przelicz wskaźniki</button>
</div>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}
else if (!string.IsNullOrWhiteSpace(infoMessage))
{
    <div class="alert alert-info" role="alert">@infoMessage</div>
}
else if (dailyIndicators.Count == 0)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row g-2 mb-2">
        <div class="col-md-3">
            <label class="form-label">Skok do daty</label>
            <InputDate @bind-Value="jumpDate" class="form-control" />
        </div>
        <div class="col-md-2 d-flex align-items-end">
            <button class="btn btn-primary w-100" @onclick="JumpToDate">Przeskocz</button>
        </div>
        <div class="col-md-7 d-flex align-items-end justify-content-end gap-2">
            <button class="btn btn-outline-secondary" @onclick="GoToPreviousPage" disabled="@(currentStartIndex == 0)">Poprzednia</button>
            <span class="align-self-center">Wiersze @VisibleStart-@VisibleEnd z @dailyIndicators.Count</span>
            <button class="btn btn-outline-secondary" @onclick="GoToNextPage" disabled="@(currentStartIndex >= MaxStartIndex)">Następna</button>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered align-middle" style="font-size: 0.85rem;">
            <thead class="table-dark">
                <tr>
                    <th>Data</th>
                    <th class="text-end">Cena</th>
                    <th class="text-end">MA krótkie</th>
                    <th class="text-end">MA długie</th>
                    <th class="text-end">SMA krótkie</th>
                    <th class="text-end">SMA długie</th>
                    <th class="text-end">RSI(14)</th>
                    <th class="text-end">MACD</th>
                    <th class="text-end">MACD Sig</th>
                    <th class="text-end">MACD Hist</th>
                    <th class="text-end">Stoch %K</th>
                    <th class="text-end">Stoch %D</th>
                    <th class="text-end">StochRSI %K</th>
                    <th class="text-end">StochRSI %D</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in VisibleRows)
                {
                    <tr>
                        <td>@row.Date.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">@Format(row.Close)</td>
                        <td class="text-end">@FormatNullable(row.Ma5)</td>
                        <td class="text-end">@FormatNullable(row.Ma10)</td>
                        <td class="text-end">@FormatNullable(row.SmaShort)</td>
                        <td class="text-end">@FormatNullable(row.Sma20)</td>
                        <td class="text-end">@FormatNullable(row.Rsi14)</td>
                        <td class="text-end">@FormatNullable(row.Macd)</td>
                        <td class="text-end">@FormatNullable(row.MacdSignal)</td>
                        <td class="text-end">@FormatNullable(row.MacdHistogram)</td>
                        <td class="text-end">@FormatNullable(row.StochK)</td>
                        <td class="text-end">@FormatNullable(row.StochD)</td>
                        <td class="text-end">@FormatNullable(row.StochRsi)</td>
                        <td class="text-end">@FormatNullable(row.StochRsiSignal)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    private readonly List<DailyIndicatorRow> dailyIndicators = [];
    private AnalysisSettings settings = new();
    private string? errorMessage;
    private string? infoMessage;
    private DateTime? jumpDate;
    private int currentStartIndex;
    private const int PageSize = 60;

    private int MaxStartIndex => dailyIndicators.Count <= PageSize ? 0 : dailyIndicators.Count - PageSize;

    private int VisibleStart => dailyIndicators.Count == 0 ? 0 : currentStartIndex + 1;

    private int VisibleEnd => dailyIndicators.Count == 0
        ? 0
        : Math.Min(currentStartIndex + PageSize, dailyIndicators.Count);

    private IEnumerable<DailyIndicatorRow> VisibleRows => dailyIndicators
        .Skip(currentStartIndex)
        .Take(PageSize);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        dailyIndicators.Clear();
        errorMessage = null;
        infoMessage = null;
        currentStartIndex = 0;

        try
        {
            settings = SettingsStore.GetCurrent();
            var result = await AnalysisService.AnalyzeAsync(settings);
            dailyIndicators.AddRange(result.DailyIndicators.OrderByDescending(x => x.Date));
        }
        catch (Exception ex)
        {
            if (IsMissingDataMessage(ex.Message))
            {
                infoMessage = "Brak danych do obliczeń. Aby rozpocząć, przejdź do Ustawień i zaimportuj plik CSV.";
            }
            else
            {
                errorMessage = $"Błąd obliczania wskaźników: {ex.Message}";
            }
        }
    }

    private void GoToPreviousPage()
    {
        if (currentStartIndex > 0)
        {
            currentStartIndex = Math.Max(0, currentStartIndex - PageSize);
        }
    }

    private void GoToNextPage()
    {
        if (currentStartIndex < MaxStartIndex)
        {
            currentStartIndex = Math.Min(MaxStartIndex, currentStartIndex + PageSize);
        }
    }

    private void JumpToDate()
    {
        if (!jumpDate.HasValue || dailyIndicators.Count == 0)
        {
            return;
        }

        int index = dailyIndicators.FindIndex(x => x.Date.Date == jumpDate.Value.Date);
        if (index < 0)
        {
            index = dailyIndicators.FindIndex(x => x.Date.Date < jumpDate.Value.Date);
        }

        if (index < 0)
        {
            index = dailyIndicators.Count - 1;
        }

        currentStartIndex = Math.Min(index, MaxStartIndex);
    }

    private static bool IsMissingDataMessage(string message)
        => message.Contains("Brak danych w bazie", StringComparison.OrdinalIgnoreCase)
           || message.Contains("Nie znaleziono pliku CSV", StringComparison.OrdinalIgnoreCase)
           || message.Contains("Wybierz zbiór danych", StringComparison.OrdinalIgnoreCase);

    private static string Format(decimal value)
        => value.ToString("0.00", CultureInfo.InvariantCulture);

    private static string FormatNullable(double? value)
        => value.HasValue ? value.Value.ToString("0.00", CultureInfo.InvariantCulture) : "–";
}
